{
  "name": "ai-teacher-platform",
  "version": "0.2.0",
  "private": true,
  "description": "AI Teacher multi-agent project platform with Vue frontend and Node backend.",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "./start-dev.sh",
    "dev:backend": "node backend/src/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "check:backend": "node --check backend/src/server.js"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
